# ── Обов'язкові ──────────────────────────────────────────────
# Токен від @BotFather
BOT_TOKEN=123456789:AAAA-your-bot-token
# Telegram id головного адміна (особистий чат з ботом): сюди приходять заявки.
ADMIN_CHAT_ID=123456789
# Додаткові адміни через кому (адмін-панель у застосунку й адмін-команди)
#ADMIN_IDS=111,222
# Публічна адреса застосунку. Без неї в боті не буде кнопок «Відкрити StarForge».
WEBAPP_URL=https://your-app.up.railway.app/

# ── Дані ─────────────────────────────────────────────────────
# ОБОВ'ЯЗКОВО на Railway: шлях до підключеного Volume. Без нього база
# живе в папці проєкту й стирається при кожному деплої.
DATA_DIR=/data

# ── Безпека ──────────────────────────────────────────────────
# Пароль для /unlock_event. Не залишай стандартний.
ADVANCED_UNLOCK_PASSWORD=change-me
# Скільки секунд дійсний initData застосунку (за замовчуванням 7 днів, 0 — без обмеження)
#INITDATA_MAX_AGE_SEC=604800
# Ліміт запитів до API з однієї адреси за хвилину
#API_RATE_PER_MIN=600

# ── Канали й посилання ───────────────────────────────────────
#CHANNEL_USERNAME=@starforge_news
#CHANNEL_URL=https://t.me/starforge_news
#CHAT_USERNAME=@starforge_chat
# Другий канал для спільного розіграшу (/joint_giveaway_start)
#PARTNER_CHANNEL_USERNAME=
# Контакт підтримки
#SUPPORT_USERNAME=@sherik17
#EARN_CHANNEL_LINK=
#PARTNER_LINK=
#TEMU_LINK=
#AGENT_LINK=

# ── Інше ─────────────────────────────────────────────────────
#PORT=3000
# Максимум зірок в одному рахунку на поповнення
#TOPUP_MAX=10000
# Мінімальна пауза між спінами одного гравця, мс
#SPIN_MIN_GAP_MS=1200
# Вимкнути фонові розклади (банк, ліга, чат, нагадування) — для тестів
#NO_SCHEDULERS=1
# Власний сервер Bot API (зазвичай не потрібно)
#TELEGRAM_API_ROOT=
